{
  "name": "ai-coding-tracker",
  "private": true,
  "version": "0.1.0",
  "description": "A local web app that auto-discovers your Claude Code and Codex CLI sessions, tracks status and next actions, and helps you revive abandoned projects.",
  "type": "module",
  "license": "MIT",
  "author": "yuuuzooo",
  "homepage": "https://github.com/yuuuzooo/ai-coding-tracker#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuuuzooo/ai-coding-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/yuuuzooo/ai-coding-tracker/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "session-tracker",
    "ai-coding",
    "dashboard",
    "local-first",
    "developer-tools"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "scan": "node --import tsx/esm server/run-scan.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.2"
  }
}
