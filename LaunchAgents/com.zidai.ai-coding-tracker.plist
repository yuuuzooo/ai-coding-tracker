<?xml version="1.0" encoding="UTF-8"?>
<!--
  ai-coding-tracker を macOS で常駐サーバー化するための LaunchAgent。

  使い方:
    1. このファイル内の以下のパスを各環境に合わせて書き換える
       - ProgramArguments の node / npm-cli.js のパス（`which node` / `which npm` で確認、npm-cli.js は npm のパスから推測）
       - WorkingDirectory（ai-coding-tracker をクローンしたディレクトリ）
       - EnvironmentVariables.PATH（必要に応じて）
       - EnvironmentVariables.HOME（自分のホームディレクトリ）
    2. ~/Library/LaunchAgents/ にコピー
    3. launchctl load ~/Library/LaunchAgents/com.zidai.ai-coding-tracker.plist

  停止: launchctl unload ~/Library/LaunchAgents/com.zidai.ai-coding-tracker.plist
  状態: launchctl list | grep ai-coding-tracker
  ログ: /tmp/ai-coding-tracker.log / /tmp/ai-coding-tracker.error.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zidai.ai-coding-tracker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/yuyamochizuki/.nvm/versions/node/v24.2.0/bin/node</string>
        <string>/Users/yuyamochizuki/.nvm/versions/node/v24.2.0/lib/node_modules/npm/bin/npm-cli.js</string>
        <string>run</string>
        <string>dev</string>
        <string>--</string>
        <string>--port</string>
        <string>5180</string>
        <string>--strictPort</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/yuyamochizuki/Desktop/000_Claude Code/dev/ai-coding-tracker</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/yuyamochizuki/.nvm/versions/node/v24.2.0/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/yuyamochizuki</string>
        <key>NODE_ENV</key>
        <string>development</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/ai-coding-tracker.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/ai-coding-tracker.error.log</string>
</dict>
</plist>
